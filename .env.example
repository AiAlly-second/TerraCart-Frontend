# Production Configuration (AWS EC2)
VITE_NODE_API_URL=http://13.204.65.103:5001
VITE_PRIMARY_API_URL=http://13.204.65.103:5001
VITE_FALLBACK_API_URL=https://terracart-backend.onrender.com

# Flask API URL (for AI/ML features)
# For local development: http://localhost:5050
# For deployed Flask backend: (update when deployed)
VITE_FLASK_API_URL=http://localhost:5050

# Stability rollout flags (A->J phased)
VITE_ENABLE_NO_RELOAD_RECOVERY=true
VITE_ENABLE_SOCKET_ROOM_JOIN_DEDUPE=true
VITE_ENABLE_EVENT_ACK_GUARD=true
VITE_ENABLE_EVENT_ORIGIN_METADATA=true
VITE_ENABLE_SOCKET_DEDUPE=true
VITE_ENABLE_REQUEST_DEDUPE=true
VITE_ENABLE_POLLING_MUTEX=true
VITE_ENABLE_SINGLETON_SOCKET_CUSTOMER=true
VITE_ENABLE_CANONICAL_EVENTS=true
VITE_ENABLE_LEGACY_EVENT_COMPAT=true
VITE_ENABLE_ROOM_ONLY_EMITS=false
VITE_ENABLE_VISIBILITY_POLLING_PAUSE=true
VITE_ENABLE_SINGLE_PRINT_LEADER=false
VITE_ENABLE_PRINT_LEASE_HEARTBEAT=false
VITE_ENABLE_PRINT_FAILSAFE_POLLING=true
VITE_ENABLE_SOCKET_BACKOFF_JITTER=true
VITE_ENABLE_SOCKET_BURST_PROTECTION=false
VITE_ENABLE_STABILITY_OBSERVABILITY=true

VITE_MAX_LISTENER_ATTACHES_PER_EVENT=8
VITE_MAX_API_CALLS_PER_MINUTE_PER_KEY=60
VITE_MAX_ROOM_JOINS_PER_MINUTE=40
VITE_MAX_RECONNECTS_PER_MINUTE=20
